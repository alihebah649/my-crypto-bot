from dataclasses import dataclass, field
from enum import Enum
from datetime import datetime, timezone
from typing import Optional


# ==========================================================
# Trade Signal
# ==========================================================

class TradeSignal(Enum):

    BUY = "BUY"

    SELL = "SELL"

    HOLD = "HOLD"


# ==========================================================
# Trade Type
# ==========================================================

class TradeType(Enum):

    SCALPING = "SCALPING"

    SWING = "SWING"

    SCALPING_SWING = "SCALPING_SWING"


# ==========================================================
# Position Status
# ==========================================================

class PositionStatus(Enum):

    OPEN = "OPEN"

    CLOSED = "CLOSED"

    RECOVERY = "RECOVERY"


# ==========================================================
# Position Model
# ==========================================================

@dataclass
class Position:

    symbol: str

    quantity: float

    entry_price: float

    highest_price: float

    stop_loss: float

    take_profit: float

    atr_stop: float

    confidence: float

    trade_type: TradeType

    recovery_mode: bool = False

    trailing_active: bool = False

    is_open: bool = True

    last_stop_time: float = 0.0

    recovery_start_time: float = 0.0

    status: PositionStatus = PositionStatus.OPEN

    entry_time: datetime = field(
        default_factory=lambda:
        datetime.now(timezone.utc)
    )

# ==========================================================
# Market Trend
# ==========================================================

class MarketTrend(Enum):

    BULL = "BULL"

    BEAR = "BEAR"

    SIDEWAYS = "SIDEWAYS"

    NEUTRAL = "NEUTRAL"


# ==========================================================
# Recovery State
# ==========================================================

class RecoveryState(Enum):

    DISABLED = "DISABLED"

    WAITING = "WAITING"

    ACTIVE = "ACTIVE"

    FINISHED = "FINISHED"


# ==========================================================
# Bot State
# ==========================================================

class BotState(Enum):

    STARTING = "STARTING"

    RUNNING = "RUNNING"

    PAUSED = "PAUSED"

    STOPPED = "STOPPED"

    ERROR = "ERROR"


# ==========================================================
# Risk Profile
# ==========================================================

class RiskProfile(Enum):

    LOW = "LOW"

    MEDIUM = "MEDIUM"

    HIGH = "HIGH"


# ==========================================================
# Trade Statistics
# ==========================================================

@dataclass
class TradeStatistics:

    total_trades: int = 0

    winning_trades: int = 0

    losing_trades: int = 0

    gross_profit: float = 0.0

    gross_loss: float = 0.0

    net_profit: float = 0.0

    total_fees: float = 0.0

    win_rate: float = 0.0

    profit_factor: float = 0.0

    average_profit: float = 0.0

    average_loss: float = 0.0

    largest_win: float = 0.0

    largest_loss: float = 0.0

    max_drawdown: float = 0.0

    consecutive_wins: int = 0

    consecutive_losses: int = 0

    current_streak: int = 0


# ==========================================================
# Recovery Information
# ==========================================================

@dataclass
class RecoveryInfo:

    state: RecoveryState = RecoveryState.DISABLED

    attempts: int = 0

    max_attempts: int = 3

    last_entry_price: float = 0.0

    target_price: float = 0.0

    started_at: Optional[datetime] = None

    last_update: Optional[datetime] = None


# ==========================================================
# Position Runtime Data
# ==========================================================

@dataclass
class PositionRuntime:

    scalp_quantity: float = 0.0

    swing_quantity: float = 0.0

    remaining_quantity: float = 0.0

    realized_profit: float = 0.0

    unrealized_profit: float = 0.0

    highest_profit_percent: float = 0.0

    lowest_profit_percent: float = 0.0

    break_even_enabled: bool = False

    break_even_price: float = 0.0

    trailing_stop_price: float = 0.0

    partial_exit_done: bool = False

    last_price: float = 0.0

    last_update: datetime = field(
        default_factory=lambda:
        datetime.now(timezone.utc)
    )


# ==========================================================
# Trade Context
# ==========================================================

@dataclass
class TradeContext:

    strategy_name: str = "Shadow Trading System V3"

    strategy_version: str = "3.0"

    exchange: str = "BINANCE"

    timeframe: str = ""

    higher_timeframe: str = ""

    market_trend: MarketTrend = MarketTrend.NEUTRAL

    confidence: float = 0.0

    score: int = 0

    notes: str = ""


# ==========================================================
# Bot Information
# ==========================================================

@dataclass
class BotInfo:

    state: BotState = BotState.STARTING

    started_at: datetime = field(
        default_factory=lambda:
        datetime.now(timezone.utc)
    )

    last_cycle: Optional[datetime] = None

    total_cycles: int = 0

    monitored_symbols: int = 0

    active_positions: int = 0

    available_balance: float = 0.0

    total_equity: float = 0.0


# ==========================================================
# Global Configuration Snapshot
# ==========================================================

@dataclass
class ConfigSnapshot:

    risk_profile: RiskProfile = RiskProfile.MEDIUM

    recovery_enabled: bool = True

    trailing_stop_enabled: bool = True

    break_even_enabled: bool = True

    max_open_positions: int = 10

    risk_per_trade: float = 0.02

    max_daily_loss: float = 0.05

    max_total_exposure: float = 0.50
